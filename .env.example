# ---------------------------------------------------------------
# New Order Global — self-hosted server config
# Copy to `.env` and fill in.
# ---------------------------------------------------------------

# HTTP port the server listens on
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Your OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Default model used when the extension does not specify one.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. OpenRouter likes to know who's calling — these show up in their
# dashboard. They are NOT sent anywhere else.
OPENROUTER_REFERER=http://localhost:3001
OPENROUTER_APP_TITLE=New Order Self-Hosted

# ---- Storage ----------------------------------------------------
# `file` (default) stores everything in JSON files in DATA_DIR.
# `mongodb` uses Mongoose; requires MONGODB_URI.
STORAGE=file
DATA_DIR=./data
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/neworder

# ---- Optional security ------------------------------------------
# Disable account creation after you've registered yourself once.
# ALLOW_REGISTER=false

# Comma-separated list of allowed CORS origins. Empty = allow all
# (sensible default since the only client is your own extension).
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
