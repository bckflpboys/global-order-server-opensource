# ---------------------------------------------------------------
# New Order Global — self-hosted server config
# Copy to `.env` and fill in.
# ---------------------------------------------------------------

# HTTP port the server listens on
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Your OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Default model used when the extension does not specify one.
OPENROUTER_MODEL=google/gemini-2.5-flash

# ---- Alternative AI Providers (optional) -------------------------
# If set, models with matching `provider` fields will route to these
# providers instead of OpenRouter. At least one provider key is required.
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# ---- OpenRouter Models (self-hosted / local) -------------------
# Define the models available in the extension UI.
# Each slot has: MODEL (OpenRouter ID), VISION, AGENT, VISION_AGENT flags.
# VISION = model can process images; AGENT = model works in the Agent page;
# VISION_AGENT = model is both vision- and agent-capable.
# Leave any slot blank to skip it. Add more slots (11, 12, …) if needed.

# --- Free Tier ---
OPENROUTER_MODEL_FREE_1=google/gemini-2.5-flash
OPENROUTER_MODEL_FREE_1_VISION=true
OPENROUTER_MODEL_FREE_1_AGENT=true
OPENROUTER_MODEL_FREE_1_VISION_AGENT=true
OPENROUTER_MODEL_FREE_2=
OPENROUTER_MODEL_FREE_2_VISION=false
OPENROUTER_MODEL_FREE_2_AGENT=false
OPENROUTER_MODEL_FREE_2_VISION_AGENT=false
OPENROUTER_MODEL_FREE_3=
OPENROUTER_MODEL_FREE_3_VISION=false
OPENROUTER_MODEL_FREE_3_AGENT=false
OPENROUTER_MODEL_FREE_3_VISION_AGENT=false
OPENROUTER_MODEL_FREE_4=
OPENROUTER_MODEL_FREE_4_VISION=false
OPENROUTER_MODEL_FREE_4_AGENT=false
OPENROUTER_MODEL_FREE_4_VISION_AGENT=false
OPENROUTER_MODEL_FREE_5=
OPENROUTER_MODEL_FREE_5_VISION=false
OPENROUTER_MODEL_FREE_5_AGENT=false
OPENROUTER_MODEL_FREE_5_VISION_AGENT=false
OPENROUTER_MODEL_FREE_6=
OPENROUTER_MODEL_FREE_6_VISION=false
OPENROUTER_MODEL_FREE_6_AGENT=false
OPENROUTER_MODEL_FREE_6_VISION_AGENT=false
